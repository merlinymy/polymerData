ANTHROPIC_API_KEY=

# The folder that keeps your data: each parsed paper (parsed/) and each finished
# extraction (extractions/). A full path, or one relative to the repo root.
# Empty means extraction/output. setup.sh, in the repo root, asks for it the first time it runs.
DATA_DIR=

# How much the extraction server and extract_features.py log: DEBUG, INFO
# (the default), WARNING or ERROR. Lines go to stdout and logs/extraction.log.
LOG_LEVEL=INFO
# discover.py: a free OpenAlex key (openalex.org/settings/api) gives 10x the keyless daily budget
OPENALEX_API_KEY=
